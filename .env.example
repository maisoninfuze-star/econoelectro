# ─────────────────────────────────────────────────────────────────────────────
# Écono Électro Services — storefront environment
# Copy to .env.local. Nothing here is required to run the site in demo mode.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.econoelectroservices.com

# ── Commerce provider ────────────────────────────────────────────────────────
# "local"   → demo catalog from src/data/products.json, cart in a cookie, checkout DISABLED
# "shopify" → Shopify Storefront API for catalog, inventory, cart and hosted checkout
COMMERCE_PROVIDER=local

# Shopify Storefront API (required when COMMERCE_PROVIDER=shopify)
# Store domain without protocol, e.g. econo-electro.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Storefront API public access token (Headless channel or custom app, "unauthenticated_read_product_listings", "unauthenticated_write_checkouts", "unauthenticated_read_checkouts")
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-07
# Optional: customer account URL to enable the "Mon compte" icon (e.g. https://shop.econoelectroservices.com/account)
NEXT_PUBLIC_SHOPIFY_ACCOUNT_URL=

# ── Forms (no vendor lock-in: any JSON webhook works — Make, Zapier, Formspree, n8n…) ─
# Contact form + stock alerts are POSTed as JSON to this URL. Leave empty to disable (the UI shows a phone fallback).
CONTACT_FORM_WEBHOOK_URL=
# Newsletter sign-ups are POSTed as JSON here (e.g. Klaviyo/Mailchimp automation webhook).
NEWSLETTER_WEBHOOK_URL=

# ── Maps ─────────────────────────────────────────────────────────────────────
# Optional Google Maps Embed API key. Without it, an interactive map is loaded through the keyless embed URL.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ── Analytics & marketing (all optional; nothing loads before consent) ───────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads conversion label for purchases, e.g. AbCdEfGhIjK
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Creatives generation (scripts/fal-creatives.mjs) ─────────────────────────
FAL_KEY=
